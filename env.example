# Optional for the local web app and workbook tests. Batch CLIs take --workbook.
OSS_WORKBOOK_PATH=

# Required for local Business Model / AX analysis and the OpenAI AX extraction batch.
OPENAI_API_KEY=

# Optional. Leave blank to use the code default (gpt-6-luna).
OPENAI_MODEL=

# Supabase project URL for server-side supplier profile lookup.
SUPABASE_URL=

# Supabase API secret key (sb_secret_...). Server-side only; never expose in web/app.js.
SUPABASE_SECRET_KEY=
