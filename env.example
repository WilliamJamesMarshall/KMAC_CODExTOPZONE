# Optional for the local web app and workbook tests. Batch CLIs take --workbook.
OSS_WORKBOOK_PATH=

# Required only when running the external OpenAI AX extraction batch.
OPENAI_API_KEY=

# Optional. Leave blank to use the code default (gpt-6-luna).
OPENAI_MODEL=

# Supabase project URL for future server-side database access.
SUPABASE_URL=

# Supabase API secret key (sb_secret_...). Server-side only; not read by current code.
SUPABASE_SECRET_KEY=
